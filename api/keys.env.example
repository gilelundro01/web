# =============================================================
# Kredensial Claude API
# =============================================================
# Cara pakai:
#   1. Salin file ini menjadi `keys.env` (di folder yang sama).
#   2. Isi nilai di kanan tanda `=`.
#   3. Simpan. Tidak perlu restart apa-apa.
#
# Format: KEY=value
#   - Tidak perlu tanda kutip.
#   - Baris yang diawali `#` adalah komentar.
#   - Spasi di sekitar `=` akan di-trim otomatis.
# =============================================================

# ---- Endpoint ----
# Untuk Anthropic resmi:
#   BASE_URL=https://api.anthropic.com
#   AUTH_HEADER=x-api-key
#
# Untuk proxy/gateway (contoh ecomagent, claude-code style):
#   BASE_URL=https://api.ecomagent.in
#   AUTH_HEADER=bearer

BASE_URL=https://api.anthropic.com
AUTH_HEADER=x-api-key

# ---- Token / API key ----
# Anthropic resmi: dari https://console.anthropic.com/settings/keys (sk-ant-...)
# Proxy:           token dari provider-mu (mis. nilai ANTHROPIC_AUTH_TOKEN)
API_KEY=isi-token-anda-di-sini
